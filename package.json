{
  "name": "repovault",
  "productName": "RepoVault",
  "version": "0.1.0",
  "description": "Google Drive 단일 저장소 기반 Git 자동 백업·복원 데스크톱 애플리케이션",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "bin": {
    "repovault": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build:core": "tsc -p tsconfig.json",
    "build:ui": "vite build",
    "build": "npm run build:core && npm run build:ui",
    "dev:ui": "vite",
    "start": "npm run build && electron .",
    "cli": "node dist/cli/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.frontend.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "tar": "^7.5.23"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "libsodium-wrappers": "^0.7.15",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "build": {
    "appId": "com.repovault.desktop",
    "productName": "RepoVault",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
